{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d .agent-memory ] && touch .agent-memory/.dirty; true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat .agent-memory/digest.md 2>/dev/null || echo 'No project memory yet. Call memory_checkpoint after the first task.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from baton-mcp baton stop-hook"
          }
        ]
      }
    ]
  }
}
